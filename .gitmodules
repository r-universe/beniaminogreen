[submodule ".registry"]
	path = .registry
	url = https://github.com/beniaminogreen/beniaminogreen.r-universe.dev
	branch = HEAD
[submodule "cragg"]
	path = cragg
	url = https://github.com/beniaminogreen/cragg
[submodule "ivrobustness"]
	path = ivrobustness
	url = https://github.com/beniaminogreen/ivrobustness
[submodule "sparsepolicytree"]
	path = sparsepolicytree
	url = https://github.com/beniaminogreen/sparsepolicytree
[submodule "zoomerGP"]
	path = zoomerGP
	url = https://github.com/beniaminogreen/zoomergp
[submodule "zoomerjoin"]
	path = zoomerjoin
	url = https://github.com/beniaminogreen/zoomerjoin
